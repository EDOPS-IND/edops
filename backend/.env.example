# Server Configuration
NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# PostgreSQL Database (TypeORM + Drizzle ORM)
DATABASE_URL=postgresql://edops:edops_dev@127.0.0.1:15432/edops
DATABASE_SCHEMA=public
TEST_DATABASE_URL=postgresql://edops:edops_dev@127.0.0.1:15432/edops_test
# DB_POOL_MAX=10
# DB_LOGGING=false
# DATABASE_SSL=false

# Authentication & Security
# SESSION_SECRET must be at least 32 characters
SESSION_SECRET=
# JWT_SECRET for Bearer token auth (defaults to SESSION_SECRET if not set)
JWT_SECRET=
# SESSION_MAX_AGE_HOURS=8

# CORS (Comma-separated origins, HTTPS required in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Rate Limiting
# THROTTLE_LIMIT=120
# AUTH_THROTTLE_LIMIT=10

# Production Proxy (trusted IP/CIDR)
# TRUST_PROXY=127.0.0.1

# Storage (S3 / MinIO - Optional for file uploads & recordings)
# S3_BUCKET=edops-recordings
# S3_REGION=ap-south-1
# S3_ENDPOINT=http://127.0.0.1:19000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Omit explicit credentials in production to use the AWS role credential chain.
